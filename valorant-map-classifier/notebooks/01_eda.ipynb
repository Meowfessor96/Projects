# Cell 1: Imports
from pathlib import Path
import matplotlib.pyplot as plt
import cv2
import random
import sys
sys.path.append('..')
from src.config import RAW_DIR, MAPS

# Cell 2: Count images per map
image_files = list(RAW_DIR.glob('*'))
print(f"Total images: {len(image_files)}")

# Cell 3: Visualize sample images
fig, axes = plt.subplots(3, 4, figsize=(16, 12))
for ax in axes.flatten():
    img_path = random.choice(image_files)
    img = cv2.imread(str(img_path))
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    ax.imshow(img)
    ax.set_title(img_path.name[:30], fontsize=8)
    ax.axis('off')
plt.tight_layout()
plt.show()

# Cell 4: Check image sizes
sizes = []
for img_path in image_files[:50]:
    img = cv2.imread(str(img_path))
    if img is not None:
        sizes.append(img.shape[:2])
print(f"Sample of image sizes (H, W): {sizes[:10]}")
